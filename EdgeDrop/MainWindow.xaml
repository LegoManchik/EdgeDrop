<Window x:Class="EdgeDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeDrop"
        Title="EdgeDrop" Height="552" Width="680" MinHeight="480" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        Icon="icon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Viewbox x:Key="AppLogoSvg" x:Shared="False" Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="256" Height="256">
                <Rectangle Width="256" Height="256" RadiusX="67" RadiusY="67"
                           Fill="{DynamicResource SystemAccentBrush}"/>

                <Path Data="M100,78 L51,128 L100,178"
                      Stroke="#FFFFFF" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                <Path Data="M51,128 L166,128"
                      Stroke="#FFFFFF" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

                <Path Data="M199,185 L199,70"
                      Stroke="#FFFFFF" StrokeThickness="24" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
        </Viewbox>

        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="{DynamicResource ScrollBarThumbBrush}" CornerRadius="3" Margin="1"/>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="checkBorder" Grid.Column="0" Width="18" Height="18"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderThickness="0" CornerRadius="4">
                                <Path x:Name="checkMark" Data="M3,9 L7,13 L15,4"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Margin="1"/>
                            </Border>

                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="Background" Value="{DynamicResource SystemAccentBrush}"/>
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}"
                    BorderThickness="0" CornerRadius="4">

                <Grid HorizontalAlignment="Right" Width="26">
                    <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="templateRoot" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton" Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Background="{TemplateBinding Background}"
                                          BorderThickness="0"/>

                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="false" Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PopupAnimation="Slide">

                                <Border x:Name="dropDownBorder" Background="{DynamicResource CardBackgroundBrush}"
                                        BorderThickness="0"
                                        CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,4,0,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                                    </Border.Effect>

                                    <ScrollViewer x:Name="DropDownScrollViewer" MaxHeight="200">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">

                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SystemAccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.025" ScaleY="1.025"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavButtonPressedBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">

                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderThickness="0">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavButtonPressedBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SystemAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SystemAccentHoverBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SystemAccentPressedBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareThemePresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                ClipToBounds="True">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource NavButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#E81123"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavButtonPressedBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Grid x:Name="trackGroup" Width="40" Height="22">
                                <Border x:Name="trackOff" Width="40" Height="22" CornerRadius="11"
                                        Background="{DynamicResource SecondaryButtonBackgroundBrush}"
                                        BorderThickness="0"/>
                                <Border x:Name="trackOn" Width="40" Height="22" CornerRadius="11"
                                        Background="{DynamicResource SystemAccentBrush}"
                                        BorderThickness="0" Opacity="0"/>
                            </Grid>

                            <Grid Width="40" Height="22" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border x:Name="thumbContainer" Width="16" Height="16" CornerRadius="8"
                                        HorizontalAlignment="Left" Margin="3,0,0,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.22" Color="#000000"/>
                                    </Border.Effect>

                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="thumbTranslate" X="0"/>
                                    </Border.RenderTransform>

                                    <Grid>
                                        <Ellipse x:Name="thumbOff" Width="16" Height="16"
                                                 Fill="White"/>

                                        <Ellipse x:Name="thumbOn" Width="16" Height="16"
                                                 Fill="White" Opacity="0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.18">

                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="trackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="thumbOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="thumbTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">

                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <DoubleAnimation Storyboard.TargetName="trackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>

                                            <DoubleAnimation Storyboard.TargetName="thumbOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="trackGroup" Property="Opacity" Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ThemedContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="10">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                                </Border.Effect>

                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="0,1"
                                TextElement.Foreground="{DynamicResource TextForegroundBrush}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIconColumn"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemArrowColumn"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="iconPresenter" Grid.Column="0" ContentSource="Icon"
                                                  Margin="0,0,10,0" VerticalAlignment="Center"
                                                  Width="16" Height="16"/>

                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource TextForegroundBrush}"/>
                                <Path x:Name="submenuArrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource SubtleTextBrush}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="12,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right" VerticalOffset="-4" HorizontalOffset="2">

                                    <Grid Margin="10">
                                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                                            </Border.Effect>

                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed"/>
                            </Trigger>

                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="submenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="itemBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowRootBorder"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderThickness="0"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                    <ContentControl Content="{StaticResource AppLogoSvg}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <TextBlock Text="EdgeDrop" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Column="1" Background="Transparent"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnTitleBarMinimizeClick" ToolTip="{DynamicResource Str_TitleBar_Minimize}">
                        <Path Data="M0,5 L10,5" Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="1"
                              SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <Button x:Name="TitleBarMaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="OnTitleBarMaximizeClick" ToolTip="{DynamicResource Str_TitleBar_Maximize}">
                        <Grid Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="MaximizeIconPath" Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"
                                  Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="1" SnapsToDevicePixels="True"/>

                            <Path x:Name="RestoreIconPath" Data="M2.5,0.5 L9.5,0.5 L9.5,7.5 M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z"
                                  Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="1" SnapsToDevicePixels="True"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="OnTitleBarCloseClick" ToolTip="{DynamicResource Str_TitleBar_Close}">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="1"
                              SnapsToDevicePixels="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Width="160" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderThickness="0"
                Padding="8,16,8,16" ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid Margin="0,0,0,16">
                        <Button Style="{StaticResource NavButtonStyle}" Click="OnToggleSidebarClick"
                                HorizontalAlignment="Left"
                                Padding="8,6" ToolTip="{DynamicResource Str_Tooltip_ToggleMenu}">

                            <Grid Width="16" Height="14" VerticalAlignment="Center">
                                <Image x:Name="MenuCustom" Width="16" Height="14" Stretch="Uniform" Visibility="Collapsed"/>

                                <Canvas x:Name="MenuDefault" Width="16" Height="14" VerticalAlignment="Center">
                                    <Path Data="M0,2 L16,2 M0,7 L16,7 M0,12 L16,12"
                                          Stroke="{DynamicResource IconBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource NavButtonStyle}" Click="OnNavHomeClick" ToolTip="{DynamicResource Str_Nav_Home}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Image x:Name="NavHomeCustom" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                                <Path x:Name="NavHomeDefault" Data="M4,10 L12,3 L20,10 L20,19 L15,19 L15,13 L9,13 L9,19 L4,19 Z"
                                      Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Width="16" Height="16"
                                      Stretch="Uniform" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="NavHomeText" Text="{DynamicResource Str_Nav_Home}" FontSize="13"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Click="OnNavDevicesClick" ToolTip="{DynamicResource Str_Nav_Devices}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Image x:Name="NavDevicesCustom" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                                <Canvas x:Name="NavDevicesDefault" Width="16" Height="16" VerticalAlignment="Center">
                                    <Rectangle Width="14" Height="10" Canvas.Left="1" Canvas.Top="1" RadiusX="1" RadiusY="1"
                                               Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"/>

                                    <Line X1="5" Y1="14" X2="11" Y2="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <Line X1="8" Y1="11" X2="8" Y2="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"/>
                                </Canvas>
                            </Grid>

                            <TextBlock x:Name="NavDevicesText" Text="{DynamicResource Str_Nav_Devices}" FontSize="13"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Click="OnNavHistoryClick" ToolTip="{DynamicResource Str_Nav_History}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Image x:Name="NavHistoryCustom" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                                <Canvas x:Name="NavHistoryDefault" Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse Width="14" Height="14" Canvas.Left="1" Canvas.Top="1"
                                             Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"/>

                                    <Path Data="M8,4 L8,8 L11,10" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>

                            <TextBlock x:Name="NavHistoryText" Text="{DynamicResource Str_Nav_History}" FontSize="13"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButtonStyle}" Click="OnNavConsoleClick" ToolTip="{DynamicResource Str_Nav_Console}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Image x:Name="NavConsoleCustom" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                                <Canvas x:Name="NavConsoleDefault" Width="16" Height="16" VerticalAlignment="Center">
                                    <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13" RadiusX="2" RadiusY="2"
                                               Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>

                                    <Path Data="M6.5,5.5 L9.5,8 L6.5,10.5"
                                          Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Grid>

                            <TextBlock x:Name="NavConsoleText" Text="{DynamicResource Str_Nav_Console}" FontSize="13"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource NavButtonStyle}" Click="OnNavSettingsClick" ToolTip="{DynamicResource Str_Nav_Settings}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Image x:Name="NavSettingsCustom" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                            <Canvas x:Name="NavSettingsDefault" Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Canvas.Left="5" Canvas.Top="5"
                                         Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"/>

                                <Path Data="M8,1 L8,3 M8,13 L8,15 M1,8 L3,8 M13,8 L15,8 M3,3 L4.5,4.5 M11.5,11.5 L13,13 M3,13 L4.5,11.5 M11.5,4.5 L13,3"
                                      Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>

                        <TextBlock x:Name="NavSettingsText" Text="{DynamicResource Str_Nav_Settings}" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="HomePageView" Grid.Column="1" Margin="24,20,24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image x:Name="AppLogoCustom" Width="20" Height="20" Stretch="Uniform" Visibility="Collapsed"/>

                        <ContentControl x:Name="AppLogoDefault" Content="{StaticResource AppLogoSvg}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="EdgeDrop" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="PowerButton" Width="124" Height="124" Click="OnPowerButtonClick"
                                Cursor="Hand" ToolTip="{DynamicResource Str_Tooltip_Power}"
                                RenderTransformOrigin="0.5,0.5"
                                MouseEnter="OnPowerButtonMouseEnter"
                                MouseLeave="OnPowerButtonMouseLeave"
                                PreviewMouseDown="OnPowerButtonPreviewMouseDown"
                                PreviewMouseUp="OnPowerButtonPreviewMouseUp">

                            <Button.RenderTransform>
                                <ScaleTransform x:Name="PowerButtonScale" ScaleX="1" ScaleY="1"/>
                            </Button.RenderTransform>

                            <Button.Effect>
                                <DropShadowEffect x:Name="PowerButtonShadow" BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                            </Button.Effect>

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CircleBorder" CornerRadius="62"
                                            Background="{TemplateBinding Background}"
                                            BorderThickness="0">

                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid x:Name="PowerIconContainer" Width="36" Height="36" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PowerIconScale" ScaleX="1" ScaleY="1"/>

                                            <RotateTransform x:Name="PowerIconRotate" Angle="0"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>

                                    <Image x:Name="PowerIconCustom" Width="36" Height="36" Stretch="Uniform" Visibility="Collapsed"/>

                                    <Canvas x:Name="PowerIconDefault" Width="36" Height="36" HorizontalAlignment="Center">
                                        <Path Data="M18,3 L18,17" Stroke="White" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M10,8.5 A14,14 0 1 0 26,8.5" Stroke="White" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Grid>

                                <TextBlock x:Name="PowerLabel" Text="ON" FontSize="13" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="StatusBadge" Text="Service active"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,22,0,4"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <TextBlock Text="{DynamicResource Str_TargetIp_Label}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TargetIpDisplayText" Text="127.0.0.1" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <Border x:Name="TargetIpExtraBadge" Background="{DynamicResource ItemContainerBackgroundBrush}"
                                    CornerRadius="9" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Cursor="Hand" Visibility="Collapsed">

                                <TextBlock x:Name="TargetIpExtraBadgeText" Text="+1" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource SystemAccentBrush}"/>
                            </Border>

                            <Button x:Name="ToggleIpHideButton" Click="OnToggleIpHideClick" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="3"
                                    ToolTip="{DynamicResource Str_Tooltip_ToggleIp}">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="4" Padding="2">
                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <Grid x:Name="EyeIconContainer" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="EyeIconScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>

                                    <Image x:Name="EyeIconCustom" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                                    <Path x:Name="EyeIconPath" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M1,12 C4,6 8,3 12,3 C16,3 20,6 23,12 C20,18 16,21 12,21 C8,21 4,18 1,12 Z M12,15 A3,3 0 1,0 12,9 A3,3 0 1,0 12,15 Z"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Button x:Name="HomeTestConnectionButton" Style="{StaticResource SecondaryButton}"
                                Click="OnTestConnectionClick" Padding="14,6" Cursor="Hand" Margin="0,0,0,10"
                                ToolTip="{DynamicResource Str_Settings_TestConnection}">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="HomePingIconCustom" Width="16" Height="16" Margin="0,0,6,0" Stretch="Uniform" Visibility="Collapsed"/>

                                <Canvas x:Name="HomePingIconDefault" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Path Data="M11,5 A6,6 0 0 1 11,11 M13,3 A10,10 0 0 1 13,13 M5,13 A10,10 0 0 1 5,3 M3,11 A6,6 0 0 1 3,5"
                                          Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                    <Ellipse Width="3" Height="3" Canvas.Left="6.5" Canvas.Top="6.5" Fill="{DynamicResource IconBrush}"/>
                                </Canvas>

                                <TextBlock Text="{DynamicResource Str_Settings_TestConnection}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="DevicesPageView" Grid.Column="1" Margin="24,20,24,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButtonStyle}" Click="OnBackToMainClick" Padding="6,6" Margin="0,0,8,0"
                            ToolTip="{DynamicResource Str_Tooltip_Back}">

                        <Path Data="M14,4 L6,12 L14,20" Stroke="{DynamicResource IconBrush}" StrokeThickness="2"
                              Width="12" Height="16" Stretch="Uniform"/>
                    </Button>

                    <TextBlock Text="{DynamicResource Str_Devices_Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DevicesScanBtn" Style="{StaticResource CardIconButtonStyle}"
                            Padding="8,6" Margin="0,0,4,0" Click="OnScanDevicesClick"
                            ToolTip="{DynamicResource Str_Devices_ScanTooltip}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{DynamicResource IconBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                  RenderTransformOrigin="0.5,0.5">

                                <Path.RenderTransform>
                                    <RotateTransform x:Name="DevicesScanRotate" Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{DynamicResource Str_Devices_Scan}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="DevicesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0"
                          PreviewMouseWheel="OnSmoothScrollViewerMouseWheel"
                          ScrollChanged="OnScrollViewerScrollChanged">

                <StackPanel>
                    <Border Style="{StaticResource AnimatedCardBorderStyle}"
                            BorderThickness="0"
                            Padding="16" Margin="0,0,0,16">

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Devices_ThisPc}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}"/>
                                    <TextBlock x:Name="DevicesThisPcIpText" Text="127.0.0.1" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource SystemAccentBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="OnCopyThisPcIpClick"
                                        Padding="12,6" VerticalAlignment="Center" ToolTip="{DynamicResource Str_Tooltip_CopyIp}">

                                    <TextBlock Text="{DynamicResource Str_Btn_Copy}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <Separator Background="{DynamicResource CardStrokeBrush}" Margin="0,8,0,8" Visibility="Collapsed"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Settings_TestMode}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>

                                <ToggleButton Grid.Column="1" x:Name="DevModeBox" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnDevModeChanged" Unchecked="OnDevModeChanged" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AnimatedCardBorderStyle}"
                            BorderThickness="0"
                            Padding="16" Margin="0,0,0,16">

                        <StackPanel>
                            <Grid x:Name="WebCardHeaderGrid" Cursor="Hand" MouseLeftButtonDown="OnWebHeaderClick">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Image x:Name="WebIconCustom" Width="20" Height="20" Stretch="Uniform" Visibility="Collapsed"/>

                                    <Path x:Name="WebIconDefault" Data="M4,6 L20,6 L20,18 L4,18 Z M2,20 L22,20"
                                          Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="1.5"
                                          Width="18" Height="16" Stretch="Uniform"/>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Web_Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="WebToggleSwitch" Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="OnWebToggleSwitchClick" Margin="0,0,8,0"
                                                  ToolTip="{DynamicResource Str_Web_ToggleTooltip}"/>

                                    <Button x:Name="WebChevronBtn" Style="{StaticResource CardIconButtonStyle}"
                                            Click="OnWebChevronClick" Padding="7,6" Cursor="Hand"
                                            ToolTip="{DynamicResource Str_Devices_CollapseTooltip}">

                                        <Grid x:Name="WebChevronContainer" Width="14" Height="14" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="WebChevronRotate" Angle="0"/>
                                            </Grid.RenderTransform>

                                            <Image x:Name="WebChevronCustom" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"/>

                                            <Path x:Name="WebChevronDefault" Data="M3,5 L7,9 L11,5"
                                                  Stroke="{DynamicResource TextForegroundBrush}" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="WebCardBody" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="{DynamicResource Str_Settings_Port}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4"/>

                                            <TextBox x:Name="WebPortBox" Width="72" Height="28" Text="8080" MaxLength="4"
                                                     HorizontalAlignment="Left"
                                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     FontSize="12" FontWeight="SemiBold"
                                                     PreviewTextInput="OnPortPreviewTextInput"
                                                     TextChanged="OnWebPortBoxTextChanged"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Web_Edge}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4"/>

                                            <ComboBox x:Name="WebEdgeBox" Width="130" Height="28"
                                                      SelectionChanged="OnWebEdgeBoxSelectionChanged">

                                                <ComboBoxItem Content="{DynamicResource Str_Edge_Bottom}" Tag="Bottom"/>

                                                <ComboBoxItem Content="{DynamicResource Str_Edge_Right}" Tag="Right"/>

                                                <ComboBoxItem Content="{DynamicResource Str_Edge_Left}" Tag="Left"/>

                                                <ComboBoxItem Content="{DynamicResource Str_Edge_Top}" Tag="Top"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str_Web_IpAddress}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4"/>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4"
                                                    Padding="10,0" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Cursor="Hand" MouseLeftButtonDown="OnCopyWebIpClick"
                                                    ToolTip="{DynamicResource Str_Tooltip_ClickToCopy}">

                                                <TextBlock x:Name="WebIpAddressText" Text="http://127.0.0.1:8080"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextForegroundBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <Button x:Name="WebCopyIpBtn" Style="{StaticResource SecondaryButton}"
                                                    Click="OnCopyWebIpClick" Padding="12,0" Height="28" VerticalAlignment="Center"
                                                    ToolTip="{DynamicResource Str_Web_CopyAddressTooltip}">

                                                <TextBlock Text="{DynamicResource Str_Btn_Copy}" FontSize="11" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border x:Name="WebQrContainer" Background="White" CornerRadius="8" Padding="6"
                                            HorizontalAlignment="Center"
                                            ToolTip="{DynamicResource Str_Web_ScanQrTooltip}">

                                        <Image x:Name="WebQrImage" Width="140" Height="140"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Stretch="Uniform"/>
                                    </Border>

                                    <Grid Margin="0,8,0,0" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="PIN: " FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>

                                            <Grid RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="WebPinScale" ScaleX="1" ScaleY="1"/>
                                                </Grid.RenderTransform>

                                                <TextBlock x:Name="WebPinText" Text="----" FontSize="20" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>

                                        <Button Grid.Column="1" x:Name="WebRegeneratePinBtn" Style="{StaticResource CardIconButtonStyle}"
                                                Margin="8,0,0,0" Padding="6" VerticalAlignment="Center"
                                                Click="OnRegeneratePinClick" ToolTip="{DynamicResource Str_Web_ResetPinTooltip}">

                                            <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                  Fill="{DynamicResource IconBrush}" Width="14" Height="14" Stretch="Uniform"
                                                  RenderTransformOrigin="0.5,0.5">

                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="WebRegeneratePinRotate" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DevicesCardsContainer"/>

                    <Button x:Name="AddDeviceButton" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Height="48" Margin="0,4,0,20"
                            Click="OnAddDeviceClick" Cursor="Hand" ToolTip="{DynamicResource Str_Devices_AddDevice}">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="22" FontWeight="Bold" Margin="0,-2,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemAccentBrush}"/>

                            <TextBlock Text="{DynamicResource Str_Devices_AddDevice}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="HistoryPageView" Grid.Column="1" Margin="24,20,24,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButtonStyle}" Click="OnBackToMainClick" Padding="6,6" Margin="0,0,8,0"
                            ToolTip="{DynamicResource Str_Tooltip_Back}">

                        <Path Data="M14,4 L6,12 L14,20" Stroke="{DynamicResource IconBrush}" StrokeThickness="2"
                              Width="12" Height="16" Stretch="Uniform"/>
                    </Button>

                    <TextBlock Text="{DynamicResource Str_History_Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="HistoryFilterBtn" Style="{StaticResource SecondaryButton}"
                                Padding="10,6" Click="OnHistoryFilterButtonClick" Cursor="Hand"
                                ToolTip="{DynamicResource Str_History_Filters}">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,6,0">
                                    <Image x:Name="HistoryFilterFunnelImg" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed"/>

                                    <Path x:Name="HistoryFilterFunnelPath" Data="M10,20 C10,20 10.5,20.89 10.55,20.89 L12.55,21.89 C13,22.12 14,21.85 14,21 L14,14 C14,13.48 14.21,12.98 14.52,12.66 L21.74,4.67 C22,4.38 22.08,3.96 21.94,3.58 C21.77,3.23 21.4,3 21,3 L3,3 C2.6,3 2.23,3.23 2.06,3.58 C1.92,3.96 2,4.38 2.26,4.67 L9.48,12.66 C9.79,12.98 10,13.48 10,14 Z"
                                          Fill="Transparent" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource Str_History_Filters}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Popup x:Name="HistoryFilterPopup" PlacementTarget="{Binding ElementName=HistoryFilterBtn}"
                               Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">

                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12"
                                    MinWidth="180">

                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#000000"/>
                                </Border.Effect>

                                <StackPanel>
                                    <CheckBox x:Name="FilterSentCheck" Content="{DynamicResource Str_History_FilterSent}"
                                              IsChecked="True" Margin="0,0,0,8" Click="OnHistoryFilterCheckChanged"/>

                                    <CheckBox x:Name="FilterReceivedCheck" Content="{DynamicResource Str_History_FilterReceived}"
                                              IsChecked="True" Margin="0,0,0,8" Click="OnHistoryFilterCheckChanged"/>

                                    <CheckBox x:Name="FilterErrorsCheck" Content="{DynamicResource Str_History_FilterErrors}"
                                              IsChecked="True" Margin="0,0,0,10" Click="OnHistoryFilterCheckChanged"/>

                                    <Separator Background="{DynamicResource CardStrokeBrush}" Margin="0,0,0,8"/>

                                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str_History_FilterReset}"
                                            FontSize="12" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Click="OnHistoryFilterResetClick"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str_History_Clear}"
                            Click="OnClearHistoryClick" VerticalAlignment="Center" Padding="12,6"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource AnimatedCardBorderStyle}"
                    BorderThickness="0"
                    Padding="12">

                <Grid>
                    <TextBlock x:Name="EmptyHistoryText" Text="{DynamicResource Str_History_Empty}"
                               FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <ListBox x:Name="HistoryListBox" Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="OnHistoryItemDoubleClick"
                             ContextMenuOpening="OnHistoryContextMenuOpening"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="OnListBoxSmoothScroll"
                             RenderTransformOrigin="0.5,0.5">

                        <ListBox.RenderTransform>
                            <TranslateTransform x:Name="HistoryListTranslate" Y="0"/>
                        </ListBox.RenderTransform>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnHistoryItemRightMouseDown"/>

                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>

                                            <TranslateTransform X="0" Y="0"/>
                                        </TransformGroup>
                                    </Setter.Value>
                                </Setter>

                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="{DynamicResource ItemContainerBackgroundBrush}"
                                                    BorderThickness="0" CornerRadius="6" Padding="12,10">

                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource InputHoverBackgroundBrush}"/>

                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 To="1.015" Duration="0:0:0.18">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>

                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 To="1.015" Duration="0:0:0.18">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>

                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                                 To="3" Duration="0:0:0.18">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>

                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                 To="1" Duration="0:0:0.18">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>

                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                 To="1" Duration="0:0:0.18">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>

                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
                                                                                 To="0" Duration="0:0:0.18">

                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                            Background="{Binding DirectionBackground}" Margin="0,0,12,0"
                                            VerticalAlignment="Center">

                                        <Image Source="{Binding IconSource}" Width="14" Height="14" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayFileName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextForegroundBrush}" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{Binding StatusForeground}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding DisplayTimestamp}" FontSize="11"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ConsolePageView" Grid.Column="1" Margin="24,20,24,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image x:Name="ConsoleHeaderIconCustom" Width="18" Height="18" Stretch="Uniform" Visibility="Collapsed"/>

                        <Canvas x:Name="ConsoleHeaderIconDefault" Width="18" Height="18" VerticalAlignment="Center">
                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5" Fill="Transparent"/>

                            <Path Data="M7.5,6 L10.5,9 L7.5,12"
                                  Stroke="{DynamicResource IconBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_Console_Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ConsoleAutoScrollBox" Content="{DynamicResource Str_Console_AutoScroll}"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button Style="{StaticResource SecondaryButton}" Click="OnConsoleCopyClick"
                            Padding="10,6" Margin="0,0,8,0" ToolTip="{DynamicResource Str_Console_Copy}">

                        <TextBlock Text="{DynamicResource Str_Console_Copy}" FontSize="12" FontWeight="SemiBold"/>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Click="OnConsoleClearClick"
                            Padding="10,6" ToolTip="{DynamicResource Str_Console_Clear}">

                        <TextBlock Text="{DynamicResource Str_Console_Clear}" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource AnimatedCardBorderStyle}"
                    BorderThickness="0" Padding="12">

                <Grid>
                    <TextBlock x:Name="EmptyConsoleText" Text="{DynamicResource Str_Console_Empty}"
                               FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <ListBox x:Name="ConsoleListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             PreviewMouseWheel="OnListBoxSmoothScroll"
                             ItemsSource="{Binding Source={x:Static local:AppLogger.Entries}}">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="logBorder" Background="Transparent" CornerRadius="4" Padding="6,3">
                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="logBorder" Property="Background" Value="{DynamicResource NavButtonHoverBrush}"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="logBorder" Property="Background" Value="{DynamicResource ItemContainerBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas, Cascadia Mono, Courier New, Segoe UI" FontSize="12">
                                    <Run Text="[" Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="{Binding TimeFormatted, Mode=OneWay}" Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="] " Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="[" Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="{Binding LevelDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding LevelBrush, Mode=OneWay}"/>

                                    <Run Text="] " Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="[" Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentBrush}"/>

                                    <Run Text="] " Foreground="{DynamicResource SubtleTextBrush}"/>

                                    <Run Text="{Binding Message, Mode=OneWay}" Foreground="{DynamicResource TextForegroundBrush}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsPageView" Grid.Column="1" Margin="24,20,24,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Style="{StaticResource NavButtonStyle}" Click="OnBackToMainClick" Padding="6,6" Margin="0,0,8,0"
                        ToolTip="{DynamicResource Str_Tooltip_Back}">

                    <Path Data="M14,4 L6,12 L14,20" Stroke="{DynamicResource IconBrush}" StrokeThickness="2"
                          Width="12" Height="16" Stretch="Uniform"/>
                </Button>

                <TextBlock Text="{DynamicResource Str_Settings_Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="0,0,8,0"
                          PreviewMouseWheel="OnSmoothScrollViewerMouseWheel"
                          ScrollChanged="OnScrollViewerScrollChanged">

                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Settings_InterfaceSection}" FontWeight="Bold" FontSize="15" Margin="4,4,0,10"
                               Foreground="{DynamicResource SystemAccentBrush}"/>

                    <Border Style="{StaticResource AnimatedCardBorderStyle}" Margin="0,0,0,12"
                            BorderThickness="0"
                            Padding="16">

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Settings_Language}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                            <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left"
                                      SelectionChanged="OnLanguageSelectionChanged">

                                <ComboBoxItem Content="{DynamicResource Str_Lang_System}" Tag="System"/>

                                <ComboBoxItem Content="Russian" Tag="Russian"/>

                                <ComboBoxItem Content="English" Tag="English"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AnimatedCardBorderStyle}" Margin="0,0,0,12"
                            BorderThickness="0"
                            Padding="16">

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Settings_Theme}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

