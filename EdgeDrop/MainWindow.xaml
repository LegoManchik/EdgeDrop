                                           Foreground="{DynamicResource SystemAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1" Margin="10,0,14,0">
                                <TextBlock x:Name="OverlaySpeedText" Text="0 KB/s" FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>

                                <TextBlock Text=" • " FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OverlayEtaText" Text="~0 sec" FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="2">
                                <Button x:Name="FooterPauseBtn" Style="{StaticResource FooterIconButtonStyle}"
                                        Margin="0,0,4,0"
                                        Click="OnFooterPauseClick" ToolTip="{DynamicResource Str_Footer_PauseTooltip}">

                                    <Image x:Name="FooterPauseIconImage" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>

                                <Button x:Name="FooterCancelBtn" Style="{StaticResource FooterIconButtonStyle}"
                                        Margin="0,0,4,0"
                                        Click="OnFooterCancelClick" ToolTip="{DynamicResource Str_Footer_CancelTooltip}">

                                    <Image x:Name="FooterCancelIconImage" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>

                                <Button x:Name="FooterQueueBtn" Style="{StaticResource FooterIconButtonStyle}"
                                        Click="OnFooterQueueToggleClick" ToolTip="{DynamicResource Str_Footer_QueueTooltip}">

                                    <Image x:Name="FooterQueueIconImage" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="TransferProgressBar" Grid.Row="1" Height="3" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource SystemAccentBrush}"
                                     Background="{DynamicResource CardStrokeBrush}"
                                     BorderThickness="0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="GlobalToastOverlay" Grid.Column="1"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Padding="16,8" CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderThickness="0"
                Panel.ZIndex="1500" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed"
                RenderTransformOrigin="0.5,1">

            <Border.RenderTransform>
                <TranslateTransform x:Name="GlobalToastTranslate" Y="40"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="GlobalToastIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"/>

                <Ellipse x:Name="GlobalToastDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                <TextBlock x:Name="GlobalToastText" Text="Ping: 12 ms" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        </Grid>

        <Grid x:Name="ColorWheelOverlay" Grid.RowSpan="2" Panel.ZIndex="1000" Visibility="Collapsed"
              Background="#99000000"
              MouseDown="OnColorWheelOverlayBackdropMouseDown">

            <Border x:Name="ColorWheelModalCard" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderThickness="0"
                    CornerRadius="14" Padding="20"
                    MouseDown="OnColorWheelOverlayCardMouseDown"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="Black"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="ColorWheelDialogTitle" Text="{DynamicResource Str_ColorDialog_AccentTitle}"
                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}"/>

                        <Button Style="{StaticResource NavButtonStyle}" Click="OnCloseColorWheelOverlayClick"
                                HorizontalAlignment="Right" Padding="6,4" ToolTip="{DynamicResource Str_ColorDialog_Close}">

                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Image x:Name="ColorWheelCloseCustom" Width="14" Height="14" Stretch="Uniform" Visibility="Collapsed"/>

                                <TextBlock x:Name="ColorWheelCloseDefault" Text="✕" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="170" Height="170" CornerRadius="85"
                                BorderThickness="0"
                                ClipToBounds="True">

                            <Grid Width="170" Height="170">
                                <Image x:Name="ColorWheelImage" Width="170" Height="170"
                                       Cursor="Cross" Stretch="None"
                                       MouseLeftButtonDown="OnColorWheelMouseDown"
                                       MouseMove="OnColorWheelMouseMove"
                                       MouseLeftButtonUp="OnColorWheelMouseUp"/>

                                <Canvas x:Name="ColorWheelCanvas" Width="170" Height="170" IsHitTestVisible="False">
                                    <Ellipse x:Name="WheelThumb" Width="20" Height="20"
                                             Stroke="White" StrokeThickness="2.5"
                                             Fill="{DynamicResource SystemAccentBrush}">

                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Color="Black" Opacity="0.6"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Width="140">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                                <Border x:Name="WheelPreviewSwatch" Width="38" Height="38" CornerRadius="8"
                                        Background="{DynamicResource SystemAccentBrush}"
                                        BorderThickness="0"
                                        Margin="0,0,10,0">

                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                                    </Border.Effect>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Settings_HexColor}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,2"/>

                                    <TextBox x:Name="HexColorBox" Width="82" Height="26"
                                             FontSize="12" FontWeight="SemiBold"
                                             Text="#0078D4"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnHexColorTextChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Str_Settings_Brightness}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                                <TextBlock x:Name="BrightnessValueText" Text="100%" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextForegroundBrush}"/>
                            </Grid>

                            <Slider x:Name="BrightnessSlider" Minimum="5" Maximum="100" Value="100"
                                    ValueChanged="OnBrightnessValueChanged" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str_ColorDialog_Close}"
                                Click="OnCloseColorWheelOverlayClick" Margin="0,0,10,0" Padding="14,6"/>

                        <Button Style="{StaticResource AccentButton}" Content="{DynamicResource Str_ColorDialog_Done}"
                                Click="OnApplyColorWheelOverlayClick" Padding="18,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="IncomingFileOverlay" Grid.RowSpan="2" Panel.ZIndex="1100" Visibility="Collapsed"
              Background="#99000000">

            <Border x:Name="IncomingFileModalCard" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderThickness="0"
                    CornerRadius="14" Padding="22"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="Black"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Incoming_Title}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,12"/>

                    <Border x:Name="SafeModeWarningContainer" Visibility="Collapsed"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource ItemContainerBackgroundBrush}"
                            CornerRadius="8" Padding="14,14" Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Image x:Name="SafeModeWarningIcon" Width="28" Height="28" Margin="0,0,0,10"
                                   HorizontalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock x:Name="SafeModeWarningText"
                                       Text="{DynamicResource Str_Transfer_DangerousWarning}"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13" LineHeight="18"
                                       Foreground="{DynamicResource TextForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="IncomingFilePromptText" Text="Accept file?" FontSize="13.5"
                               TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,12"/>

                    <TextBlock x:Name="IncomingFileTimeoutText" Text="Waiting: 30s" FontSize="11.5"
                               Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="IncomingFileRejectBtn" Style="{StaticResource SecondaryButton}"
                                Content="{DynamicResource Str_Incoming_Reject}"
                                Click="OnIncomingFileRejectClick" Margin="0,0,10,0" Padding="16,7"/>

                        <Button x:Name="IncomingFileAcceptBtn" Style="{StaticResource AccentButton}"
                                Content="{DynamicResource Str_Incoming_Accept}"
                                Click="OnIncomingFileAcceptClick" Padding="20,7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="DiagnosticsModalOverlay" Grid.RowSpan="2" Panel.ZIndex="1150" Visibility="Collapsed"
              Background="#99000000">

            <Border x:Name="DiagnosticsModalCard" Width="460" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="14" Padding="22"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Str_Diagnostics_Title}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"/>

                        <Button Style="{StaticResource CardIconButtonStyle}" HorizontalAlignment="Right"
                                Click="OnCloseDiagnosticsModalClick" ToolTip="{DynamicResource Str_Tooltip_Close}">

                            <Image x:Name="DiagnosticsCloseIcon" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"
                                  PreviewMouseWheel="OnSmoothScrollViewerMouseWheel">

                        <StackPanel x:Name="DiagnosticsItemsContainer"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource AccentButton}" Content="{DynamicResource Str_Diagnostics_Close}"
                            HorizontalAlignment="Right" Click="OnCloseDiagnosticsModalClick" Padding="20,7"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
