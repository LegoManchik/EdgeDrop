<Application x:Class="EdgeDrop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EdgeDrop"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="InputHoverBackgroundBrush" Color="#222222"/>
        <SolidColorBrush x:Key="InputStrokeBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="TextForegroundBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="IconBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="NavButtonHoverBrush" Color="#222222"/>
        <SolidColorBrush x:Key="NavButtonPressedBrush" Color="#121212"/>
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="ItemContainerBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="SystemAccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="SystemAccentHoverBrush" Color="#1A86D9"/>
        <SolidColorBrush x:Key="SystemAccentPressedBrush" Color="#006CBE"/>
        <SolidColorBrush x:Key="PowerActiveBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="PowerInactiveBrush" Color="#767676"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#54B054"/>
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#444444"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#666666"/>
        <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#331A1A"/>
        <SolidColorBrush x:Key="ErrorBorderBrush" Color="#00000000"/>
        <SolidColorBrush x:Key="ErrorTitleBrush" Color="#FF5252"/>
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#3E3E3E"/>
        <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#383838"/>
    </Application.Resources>
</Application>
